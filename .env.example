# ---------------------------------------------------------------------------
# AI Quest — 模型接入配置
# 复制本文件为 .env.local 并填入真实密钥。.env.local 已在 .gitignore 中，不会被提交。
# ---------------------------------------------------------------------------

# DeepSeek API Key（必填，否则 Boss 试炼自动降级为关键词评分、追问功能不可用）
DEEPSEEK_API_KEY=

# 可选：换成其他 OpenAI 兼容端点
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：模型名，默认 deepseek-chat
# DEEPSEEK_MODEL=deepseek-chat

# 可选：每个 IP 每小时的调用上限，默认 30
# LLM_RATE_LIMIT=30
